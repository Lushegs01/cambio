{
  "name": "cambio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && npm run build:server",
    "build:server": "node scripts/build-server.mjs",
    "start": "node server.js",
    "preview": "npm run build && npm start",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cambio \"vitest run -c vitest.rules.config.ts\"",
    "verify:chain": "tsx scripts/verify-contracts.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-wagmi": "^1.8.24",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.4",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^4.21.2",
    "firebase-admin": "14.5.0",
    "lucide-react": "^0.546.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1",
    "viem": "^2.57.7",
    "vite": "^8.3.0",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.34.1",
    "jsdom": "30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@11.19.0",
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
